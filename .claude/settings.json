{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-multi-commit-pr.sh",
						"timeout": 15,
						"statusMessage": "Checking one-commit-per-PR rule"
					}
				]
			},
			{
				"matcher": "EnterWorktree",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-enterworktree.sh",
						"timeout": 15,
						"statusMessage": "Redirecting to git worktree add"
					}
				]
			}
		]
	}
}
